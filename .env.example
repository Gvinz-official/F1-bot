# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Публичный HTTPS-адрес мини-приложения.
# Локально: адрес туннеля cloudflared. На сервере: https://ВАШ-ДОМЕН.duckdns.org
WEBAPP_URL=https://example.trycloudflare.com

# Только для сервера (docker compose): домен без https://, тот же, что в WEBAPP_URL
DOMAIN=example.duckdns.org

# Postgres (Neon и т.п.) для облака. Если пусто, используется локальный файл SQLite.
DATABASE_URL=

# Необязательно (локальный запуск)
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/f1bot.sqlite3

# 1 = открывать приложение в обычном браузере без Telegram (только для разработки!)
DEV_MODE=0
